; MisoStory runtime project (Godot 4.7). Blender stays the environment source; see docs/runtime/ARCHITECTURE.md.

config_version=5

[application]

config/name="MisoStory"
config/description="Classic Maple Island as an isometric 3D game. Gameplay data: MeowDB MS Classic (game/data/canonical)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
Data="*res://scripts/autoload/data.gd"
Controls="*res://scripts/autoload/controls.gd"
Game="*res://scripts/autoload/game_state.gd"
Saves="*res://scripts/autoload/save_service.gd"
MapSession="*res://scripts/autoload/map_session.gd"
Debug="*res://scripts/autoload/debug_tools.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[filesystem]

import/blender/enabled=false

[importer_defaults]

scene={
"import_script/path": "res://scripts/core/art/art_pack_post_import.gd"
}

[layer_names]

3d_physics/layer_1="walkable"
3d_physics/layer_2="blocking"
3d_physics/layer_3="containment"
3d_physics/layer_4="player"
3d_physics/layer_5="monsters"
3d_physics/layer_6="interactables"
3d_physics/layer_7="scenery"
3d_physics/layer_8="kill"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=65536

[rendering]

anti_aliasing/quality/msaa_3d=2
