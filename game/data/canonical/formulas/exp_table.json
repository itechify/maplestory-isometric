{
  "id": "exp_table",
  "name": "EXP to next level",
  "value_kind": "exp_to_next",
  "semantics": [
    "exp_to_next for level L = EXP needed to go from level L (at 0 EXP) to level L+1. It is NOT cumulative.",
    "total_from_lv1 for level L = cumulative EXP from level 1 at 0 EXP to reach level L+1 (sum of exp_to_next for levels 1..L). MeowDB: \"Total from Lv 1 is all the EXP needed to reach the next level, starting from level 1.\"",
    "Level-up resets the EXP bar to 0 (glossary: \"Hitting the next level. Resets your EXP bar to 0.\")."
  ],
  "level_min": 1,
  "level_max_listed": 99,
  "level_cap": 100,
  "level_cap_note": "Level 100. Nexon set the maximum character level at Lv. 100 in its Founder's Access release notes.",
  "confidence": {
    "current_levels": [
      1,
      49
    ],
    "historical_levels": [
      50,
      99
    ],
    "statements": [
      "Values through level 49 match current play. Level 50 and up follow the historical table.",
      "Levels 1 to 49 are confirmed in the current game. Levels 50 to 99 reproduce a historical reference table and remain planning estimates until they are verified in current play.",
      "Levels 1 through 49 match current MapleStory Classic play. Levels 50 through 99 remain a historical planning reference until current play reaches them."
    ]
  },
  "formula_segments": [
    {
      "levels": [
        1,
        5
      ],
      "formula": "(floor(level² / 2) + 15) × level",
      "status": "Current"
    },
    {
      "levels": [
        6,
        50
      ],
      "formula": [
        "q = floor(level² / 3)",
        "(q + 19) × q"
      ],
      "status": "Current through Lv 49"
    },
    {
      "levels": [
        51,
        99
      ],
      "formula": "trunc(previous level's EXP × 1.0548)",
      "status": "Historical"
    }
  ],
