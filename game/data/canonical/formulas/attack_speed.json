{
  "id": "attack_speed",
  "name": "Attack speed tiers and animation timing",
  "status": "MeowDB's Model (MeowDB's own model of the mechanic; not a confirmed game constant)",
  "status_note": "The frame durations and their attack-speed conversion are confirmed for ordinary COT2 characters, including Savage Blow. We still round displayed times up to 30 ms steps; that final rounding remains a model.",
  "timing_formula": [
    "timingTier = clamp(resolvedTier, 0, 10)",
    "ScaledFrame = truncTowardZero(FrameDelay × (10 + timingTier) / 16)",
    "nativeMs = Σ ScaledFrame",
    "Player-facing Animation Time = 30 × ceil(nativeMs / 30)"
  ],
  "timing_tier_clamp": [
    0,
    10
  ],
  "tier_scale": "(10 + timingTier) / 16",
  "neutral_tier": 6,
  "neutral_tier_note": "At speed tier 6 every frame keeps its base length.",
  "display_rounding_ms": 30,
  "display_rounding_note": "Skill pages display the 30 ms player-facing Animation Time; current simulator throughput uses its resolved branch-completion durations before that display-only rounding, so the two values should not be substituted for one another.",
