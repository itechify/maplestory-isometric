      "section": "On accept",
      "lines": [
        {
          "text": "My goodness. I've been wandering around town, and I see so many recyclable items just being thrown away! Say, can you help me collect some of them? Don't worry, I'll reward you well for your effort."
        }
      ],
      "branches": [
