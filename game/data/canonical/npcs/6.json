  "dialogue": [
    {
      "text": "Are you having a pleasant journey so far?"
    },
    {
      "text": "Go and enjoy the adventures that await!"
    }
  ],
  "idle_chatter": [
    {
      "text": "You should train well before continuing your journey."
    },
    {
      "text": "Well done making it here!"
    },
    {
      "text": "This is the exit to Mushroom Town."
    },
    {
      "text": "If you want to move to the next stage, talk to me."
    },
    {
      "text": "Be careful. Once you leave this place, you'll see monsters roaming around."
    },
    {
      "text": "Are you ready for adventure?"
    },
    {
      "text": "Now it's up to you to train yourself. Good luck!"
    },
    {
      "text": "We instructors are all related. Roger is my older brother and Robin is my younger brother, and we're all working here together."
    },
    {
      "text": "Yoohoo!"
    },
    {
      "text": "So what's my relationship with Roger? Hahaha, he's my older brother!"
    }
  ],
