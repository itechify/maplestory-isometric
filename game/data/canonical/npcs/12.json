  "dialogue": [
    {
      "text": "I can't stay in this town forever. Is there anyone who can help me?"
    },
    {
      "text": "Thanks for earlier. Now if I could just get a little more money, I could start my business. Are you still using the weapon I gave you?"
    }
  ],
  "idle_chatter": [
    {
      "text": "Heh, looks like I'm still the best looking man in this town."
    },
    {
      "text": "Hey you! What are you looking at? If you're admiring my good looks, just go ahead and say it!"
    },
    {
      "text": "One of these days, I'll be the one operating that huge ship and setting off for bigger, better lands..."
    }
  ],
