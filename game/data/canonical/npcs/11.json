  "dialogue": [
    {
      "text": "You can become a lot stronger if you get trained by me. Come to me whenever you're ready."
    },
    {
      "text": "Why don't you go out and explore the big, wide world?"
    }
  ],
  "idle_chatter": [
    {
      "text": "Hey, do you know me? No? What's wrong with you?"
    },
    {
      "text": "If you're thinking of challenging me, dream on."
    },
    {
      "text": "Is there anyone out there who can give me a good fight?"
    }
  ],
